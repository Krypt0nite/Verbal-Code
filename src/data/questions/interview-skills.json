    {
      "id": "is-explain-to-non-technical",
      "title": "Explaining a technical topic to a non-technical person",
      "prompt": "Explain what an API is to a non-technical manager in under one minute, using an analogy and avoiding jargon.",
      "categoryId": "interview-skills",
      "subcategoryId": "technical-communication",
      "difficulty": "beginner",
      "suggestedDurationSec": 60,
      "tags": [
        "analogy",
        "clarity"
      ],
      "rubricId": "communication",
      "modes": [
        "interview",
        "deep-research",
        "mock-interview",
        "off-the-cuff"
      ],
      "expectedConcepts": [],
      "modelAnswer": "Lead with the purpose: 'An API is the way two pieces of software ask each other for things.' Analogy: a restaurant menu and waiter — you order from the menu without entering the kitchen. Tie it to their world: 'When our app shows delivery status, it's asking the courier's system through their API.' Close with why it matters: speed, reuse, and depending on another company's system."
    },
    {
      "id": "is-think-aloud-two-sum",
      "title": "Think aloud: solving Two Sum",
      "prompt": "Solve the Two Sum problem out loud as you would in a coding interview: clarify the problem, state a brute-force approach, improve it, give the complexity and mention edge cases.",
      "categoryId": "interview-skills",
      "subcategoryId": "problem-solving-explanations",
      "difficulty": "beginner",
      "suggestedDurationSec": 120,
      "tags": [
        "think-aloud",
        "hashing"
      ],
      "rubricId": "dsa",
      "modes": [
        "interview",
        "deep-research",
        "mock-interview",
        "off-the-cuff"
      ],
      "expectedConcepts": [
        {
          "id": "clarify",
          "label": "Clarify input/output and constraints",
          "criterion": "edge-cases",
          "keywords": [
            "clarify",
            "assume",
            "constraint",
            "can i assume"
          ]
        },
        {
          "id": "brute",
          "label": "Brute force O(n^2)",
          "criterion": "alternatives",
          "keywords": [
            "brute force",
            "n squared",
            "nested loop",
            "every pair"
          ]
        },
        {
          "id": "hash",
          "label": "Hash map of value → index",
          "criterion": "correctness",
          "keywords": [
            "hash map",
            "complement",
            "target minus",
            "dictionary"
          ]
        },
        {
          "id": "time",
          "label": "O(n) time",
          "criterion": "time-complexity",
          "keywords": [
            "linear",
            "o of n",
            "one pass"
          ]
        },
        {
          "id": "space",
          "label": "O(n) extra space",
          "criterion": "space-complexity",
          "keywords": [
            "o of n space",
            "extra space"
          ]
        },
        {
          "id": "edge",
          "label": "Duplicates, no solution, same element twice",
          "criterion": "edge-cases",
          "keywords": [
            "duplicate",
            "no solution",
            "same element",
            "negative"
          ]
        }
      ],
      "modelAnswer": "Clarify: return indices, exactly one solution? Can the same element be used twice? Brute force: check every pair, O(n²) time, O(1) space. Improve: one pass with a hash map from value to index; for each x check whether target − x is already in the map, otherwise insert x. O(n) time, O(n) space. Edge cases: duplicates like [3,3] (check before inserting), negative numbers, no valid pair. Then test with a small example aloud."
    },
