{
  "categoryId": "interview-skills",
  "questions": [
    {
      "id": "is-tell-me-about-yourself",
      "title": "Tell me about yourself",
      "prompt": "Answer 'Tell me about yourself' for a software engineering interview. Aim for a structure of present, past and future, connect your experience to the role, and finish within the time limit.",
      "categoryId": "interview-skills",
      "subcategoryId": "personal-introduction",
      "difficulty": "beginner",
      "suggestedDurationSec": 90,
      "tags": [
        "introduction",
        "pitch"
      ],
      "rubricId": "communication",
      "modes": [
        "interview",
        "deep-research",
        "mock-interview",
        "off-the-cuff"
      ],
      "expectedConcepts": [],
      "modelAnswer": "Present: 'I'm a backend engineer with two years of experience building C++ and Go systems.' Past: one or two highlights with impact — a project, a measurable result, a skill it demonstrates. Future: why this role and company are the logical next step. Keep it to about 60–90 seconds, avoid reciting your CV line by line, and end with a hook the interviewer can ask about."
    },
    {
      "id": "is-project-deep-dive",
      "title": "Project deep dive",
      "prompt": "Pick one project you built and explain it as you would to an interviewer: the problem, your role, the architecture, one hard technical decision, and what you would improve.",
      "categoryId": "interview-skills",
      "subcategoryId": "project-deep-dives",
      "difficulty": "intermediate",
      "suggestedDurationSec": 180,
      "tags": [
        "projects",
        "storytelling"
      ],
      "rubricId": "behavioral",
      "modes": [
        "interview",
        "deep-research",
        "mock-interview",
        "off-the-cuff"
      ],
      "expectedConcepts": [
        {
          "id": "context",
          "label": "Problem and why it mattered",
          "criterion": "context",
          "keywords": [
            "problem",
            "the goal",
            "users",
            "needed"
          ]
        },
        {
          "id": "responsibility",
          "label": "Your specific role",
          "criterion": "responsibility",
          "keywords": [
            "my role",
            "i was responsible",
            "i owned",
            "i built",
            "i designed"
          ]
        },
        {
          "id": "actions",
          "label": "Architecture and a hard decision",
          "criterion": "actions",
          "keywords": [
            "architecture",
            "decided",
            "trade off",
            "chose",
            "because"
          ]
        },
        {
          "id": "results",
          "label": "Measurable outcome",
          "criterion": "results",
          "keywords": [
            "result",
            "reduced",
            "improved",
            "latency",
            "throughput",
            "percent"
          ]
        },
        {
          "id": "reflection",
          "label": "What you would improve",
          "criterion": "reflection",
          "keywords": [
            "improve",
            "differently",
            "next time",
            "learned"
          ]
        }
      ],
      "modelAnswer": "Problem: what it solved and for whom (one or two sentences). Role: what you personally owned. Architecture: the main components and data flow at a whiteboard level. Hard decision: the options you considered, the trade-off, and why you chose one. Result: numbers if you have them (latency, throughput, users, time saved). Reflection: what you would change now. Be ready to go two levels deeper on any component you mention."
    },
