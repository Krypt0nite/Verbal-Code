# Optional AI evaluation. Placeholders only — never commit real keys.
# For local development copy this file to `.dev.vars` (read by wrangler).
# In production set these in Cloudflare Pages → Settings → Variables and Secrets (mark AI_API_KEY as a secret).

# Any OpenAI-compatible Chat Completions base URL (without /chat/completions):
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=replace-with-your-key
AI_MODEL=openai/gpt-oss-120b
AI_PROVIDER_LABEL=Groq (GPT-OSS 120B)
# Shown in the consent dialog. Describe the provider's data terms honestly.
AI_DATA_NOTICE=Check the provider's current data-use terms before enabling.

# Limits (optional). Reasoning models like gpt-oss spend tokens thinking, so keep the output limit high.
AI_TIMEOUT_MS=40000
AI_MAX_REQUESTS_PER_MINUTE=6
AI_MAX_OUTPUT_TOKENS=6000
# Per-provider timeout above; total time for the whole fallback chain:
AI_TOTAL_TIMEOUT_MS=80000

# Fallbacks (optional), tried in this order when the primary model is rate-limited or fails:
# 1. A second OpenAI-compatible provider, e.g. Google Gemini (free key at aistudio.google.com):
# AI2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI2_API_KEY=replace-with-your-key
# AI2_MODEL=gemini-2.5-flash
# AI2_PROVIDER_LABEL=Google Gemini (2.5 Flash)
# 2. More models on the primary provider ("model=Label", comma-separated):
# AI_FALLBACK_MODELS=openai/gpt-oss-20b=Groq (GPT-OSS 20B),qwen/qwen3.8-27b=Groq (Qwen 3.8 27B)
# 3. Cloudflare Workers AI. Needs the [ai] binding in wrangler.toml; no key required:
# WORKERS_AI_MODEL=@cf/openai/gpt-oss-20b
