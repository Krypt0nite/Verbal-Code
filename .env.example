# Optional AI evaluation. Placeholders only — never commit real keys.
# For local development copy this file to `.dev.vars` (read by wrangler).
# In production set these in Cloudflare Pages → Settings → Variables and Secrets (mark AI_API_KEY as a secret).

# Any OpenAI-compatible Chat Completions base URL (without /chat/completions):
#   Groq:   https://api.groq.com/openai/v1
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=replace-with-your-key
AI_MODEL=openai/gpt-oss-120b
AI_PROVIDER_LABEL=Groq (GPT-OSS 120B)
# Shown in the consent dialog. Describe the provider's data terms honestly.
AI_DATA_NOTICE=Check the provider's current data-use terms before enabling.

# Limits (optional). Reasoning models like gpt-oss spend tokens thinking, so keep the output limit high.
AI_TIMEOUT_MS=40000
AI_MAX_REQUESTS_PER_MINUTE=6
AI_MAX_OUTPUT_TOKENS=6000
